    updateStatus();
    scheduleAIMove(200);
  });

  swapStarterBtn.addEventListener('click', async () => {
    const newStart = startingSymbol === 'X' ? 'O' : 'X';
    if(mode === 'online'){
      if(!isHost){
        alert('Only the host can change who starts in online mode.');
        return;
      }
