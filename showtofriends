  const fitsH = canPlace(grid, r, c, len, 'h');
  const fitsV = canPlace(grid, r, c, len, 'v');

  if(!fitsH && !fitsV){
    alert("Ship doesn't fit here.");
    return;
  }

  pendingPlacement = {r, c, len, shipIndex: idx, player};
  const shipNameText = `${player}: ${SHIP_NAMES[idx]} at (${r+1}, ${c+1})`;
